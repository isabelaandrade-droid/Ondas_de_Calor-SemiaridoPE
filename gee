// Calcular EVI min e max globalmente
var colecaoBase1 = carregarColecaoLandsat()
  .map(maskClouds)
  .map(adicionarAlbedo)       // calcula albedo com bandas originais
  .map(padronizarBandas)      // adiciona bandas padronizadas e mantém o albedo
  .map(calcularEVI)
  .map(function(img) {
      var evi = img.select('EVI');
  // Máscara para manter só valores plausíveis entre -1 e 1
      var mask = evi.gte(-1).and(evi.lte(1));
      return img.updateMask(mask);
});

