//    PADRONIZAÇÃO DE BANDAS       //
// =============================== //
// Função para padronizar as bandas do Landsat 5 e 8
function padronizarBandas(image) {
  var sat = ee.String(image.get('SPACECRAFT_ID'));

  var isL5 = sat.compareTo('LANDSAT_5').eq(0);
  var isL8or9 = sat.compareTo('LANDSAT_8').eq(0).or(sat.compareTo('LANDSAT_9').eq(0));

  var nir = ee.Image(ee.Algorithms
                       .If(isL5, image.select('B4'), image.select('B5')))
                       .rename('NIR');
                       
  var red = ee.Image(ee.Algorithms
                       .If(isL5, image.select('B3'), image.select('B4')))
                       .rename('RED');
  
  var blue = ee.Image(ee.Algorithms
                       .If(isL5, image.select('B1'), image.select('B2')))
                       .rename('BLUE');
                       
  var green = ee.Image(ee.Algorithms
                         .If(isL5, image.select('B2'), image.select('B3')))
                         .rename('GREEN');

  var thermal = ee.Image(ee.Algorithms
                         .If(isL5, image.select('B6'), image.select('B10')))
                         .rename('TERMAL');

return image.addBands([nir, red, blue, green, thermal])
            .select(['NIR', 'RED', 'BLUE', 'GREEN', 'TERMAL', 'albedo']);

}


