// Função para calcular o Albedo dependendo do satélite
function adicionarAlbedo(image) {
  // Fórmula para Landsat 5 TM
  var albedoL5 = image.expression(
    '0.356*B1 + 0.130*B3 + 0.373*B4 + 0.085*B5 + 0.072*B7 - 0.0018', {
      'B1': image.select('B1'),
      'B3': image.select('B3'),
      'B4': image.select('B4'),
      'B5': image.select('B5'),
      'B7': image.select('B7')
    }).rename('albedo');

  // Fórmula para Landsat 9
  var albedoL89 = image.expression(
    '0.300*B2 + 0.278*B4 + 0.233*B5 + 0.143*B6 + 0.036*B7 - 0.018', {
      'B2': image.select('B2'),
      'B4': image.select('B4'),
      'B5': image.select('B5'),
      'B6': image.select('B6'),
      'B7': image.select('B7')
    }).rename('albedo');

  // Verifica se é Landsat 5 ou 8 usando .compareTo(…) == 0
  var id = ee.String(image.get('SPACECRAFT_ID'));
  var albedo = ee.Image(ee.Algorithms.If(
                        id.compareTo('LANDSAT_5')
                          .eq(0), albedoL5,
    
                        ee.Algorithms.If(id.compareTo('LANDSAT_8')
                          .eq(0)
                          .or(id.compareTo('LANDSAT_9')
                          .eq(0)), albedoL89, 
               
               ee.Image(0).rename('albedo'))
  ));

  return image.addBands(albedo);
}

