var exportarMunicipioAno = function(nomeMicro, nomeMunicipio) {

  var feicaoMunicipio = roi.filter(ee.Filter.eq('NM_MICRO', nomeMicro))
                           .filter(ee.Filter.eq('NM_MUNICIP', nomeMunicipio));
  var geomMunicipio = feicaoMunicipio.geometry();

  // Gerar grade por município
  var grad = gradeFixa.filterBounds(geomMunicipio);

  var colecaoMunicipio = colecaoBase2.filterBounds(geomMunicipio);
  var ano = ee.List.sequence(1994, 2023);

  ano.getInfo().forEach(function(ano) {
    
    var colecaoAno = colecaoMunicipio.filter(ee.Filter.calendarRange(ano, ano, 'year'));

      var todasAmostras = colecaoAno.map(function(image){
        var data = ee.Date(image.get('system:time_start'));
        var horaUTC = data.get('hour'); // Adiciona a hora

        // Converter UTC para horário local (Brasília: UTC-3)
        var horaLocal = ee.Number(horaUTC).subtract(3).mod(24);

        // Classificar como manhã, tarde ou noite
        var periodo = ee.String(ee.Algorithms.If(
          horaLocal.lte(12), 'Matutino',
          ee.Algorithms.If(horaLocal.lte(17), 'Vespertino', 'Noturno')
        ));

        return image.select(['EVI','LST','albedo'])
                    .addBands(usoSolo)
                    .sampleRegions({
                      collection: grad,
                      scale: 30,
                      geometries: true
                    })
                    .map(function(f){
                      return f
                              .set('pixel_id', f.get('pixel_id'))
                              .set('dia', data.get('day'))
                              .set('mes', data.get('month'))
                              .set('ano', data.get('year'))
                              .set('hora_local', horaLocal)
                              .set('periodo', periodo)
                              .set('microrregiao', nomeMicro)
                              .set('municipio', nomeMunicipio);
                    });
      }).flatten();

      var nomeMicroNorm = normalizarNome(nomeMicro);
      var nomeMunicipioNorm = normalizarNome(nomeMunicipio);

      Export.table.toDrive({
        collection: todasAmostras,
        description: 'GradePixel_' + nomeMicroNorm + '_' + nomeMunicipioNorm + '_' + ano,
        fileFormat: 'CSV'
      });
  
    });
  };


