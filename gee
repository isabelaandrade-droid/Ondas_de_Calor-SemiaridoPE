function exportarERA5_MicroMunicipio(nomeMicro, nomeMunicipio) {
  var feicao = roi.filter(ee.Filter.eq('NM_MICRO', nomeMicro))
                  .filter(ee.Filter.eq('NM_MUNICIP', nomeMunicipio));
  var geom = feicao.geometry();

  var grade = gradeFixa.filterBounds(geom); //
  var colecaoLocal = era5.filterBounds(geom);
  var ano = ee.List.sequence(1994, 2023);

  ano.evaluate(function(listaAnos){
    listaAnos.forEach(function(ano){
      var colecaoAno = colecaoLocal.filter(ee.Filter.calendarRange(ano, ano, 'year'));

      var amostras = colecaoAno.map(function(image){
        var data = ee.Date(image.get('system:time_start'));
        var horaUTC = data.get('hour'); // Adiciona a hora
        
        // Converter UTC para horário local (Brasília: UTC-3)
        var horaLocal = ee.Number(horaUTC).subtract(3).mod(24);
        
        // Classificar como manhã, tarde ou noite
        var periodo = ee.String(ee.Algorithms.If(
          horaLocal.lte(12), 'Matutino',
          ee.Algorithms.If(horaLocal.lte(18), 'Vespertino', 'Noturno')
        ));

        
        return image.select(['tmax_C','tmin_C'])
                  .sampleRegions({
                    collection: grade,
                    scale: 11100,
                    geometries: true
                  })
                  .map(function(f){
                    return f
                              .set('pixel_id', f.get('pixel_id'))
                              .set('dia', data.get('day'))
                              .set('mes', data.get('month'))
                              .set('ano', data.get('year'))
                              .set('hora_local', horaLocal)
                              .set('periodo', periodo)
                              .set('microrregiao', nomeMicro)
                              .set('municipio', nomeMunicipio);
                  });
      }).flatten();
      
      var nomeMicroNorm = normalizarNome(nomeMicro);
      var nomeMunicipioNorm = normalizarNome(nomeMunicipio);

      Export.table.toDrive({
        collection: amostras,
        description: 'ERA5_TempAr_' + nomeMicroNorm + '_' + nomeMunicipioNorm + '_' + ano,
        fileFormat: 'CSV'
      });
    });
  });
}

