// FUNÇÃO: GRADE DE PONTOS
// ========================================= //
function gerarGrade(geom, tamanhoCelula) {
  var bounds = geom.bounds();
  var grad = ee.Image.pixelLonLat()
                .sample({
                  region: geom,
                  scale: tamanhoCelula,
                  projection: 'EPSG:4326',
                  geometries: true
                });
  grad = ee.Algorithms.If(
    grad.size().eq(0),
    ee.FeatureCollection([ee.Feature(geom.centroid())]),
    grad
  );
  return ee.FeatureCollection(grade);
}

