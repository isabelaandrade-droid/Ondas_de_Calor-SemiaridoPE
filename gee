// Função para calcular Pv (limitar para evitar valores fora do intervalo)
function calcularPv(image) {
  var pv = image.expression(
    '((EVI - eviMin) / (eviMax - eviMin)) ** 2', {
      'EVI': image.select('EVI'),
      'eviMin': eviMin,
      'eviMax': eviMax
    }).rename('pv')
      .clamp(0, 1);
  
  // Limita pv para o intervalo [0,1]
  //pv = pv.where(pv.lt(0), 0).where(pv.gt(1), 1);
  
  return image.addBands(pv)
              .set('year', image.date().get('year'))
              .set('month', image.date().get('month'));
}

