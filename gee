// Função para normalizar nomes de microrregiões e municípios
function normalizarNome(nome) {
  // Converte pra texto simples se vier de ee.String
  if (nome instanceof ee.String) {
    nome = nome.getInfo(); // executa só fora do loop server-side
  }

  // Tabela de substituições (regex global)
  var mapa = {
    'á':'a','ã':'a','â':'a','à':'a',
    'Á':'A','Ã':'A','Â':'A','À':'A',
    'é':'e','ê':'e','É':'E','Ê':'E',
    'í':'i','Í':'I',
    'ó':'o','õ':'o','ô':'o','Ó':'O','Õ':'O','Ô':'O',
    'ú':'u','ü':'u','Ú':'U','Ü':'U',
    'ç':'c','Ç':'C'
  };

  // Substitui todos os acentos
  for (var k in mapa) {
    var regex = new RegExp(k, 'g');
    nome = nome.replace(regex, mapa[k]);
  }

  // Troca espaços e traços por "_"
  nome = nome.replace(/[\s-]+/g, '_');

  return nome;
}


