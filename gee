// Função para calcular emissividade
function calcularEmissividade(image) {
  var pv = image.select('pv');
  
  // Calcular emissividade       
  var emissividade = image.expression(
    '0.004 * pv + 0.986', {
      'pv': pv
  }).rename('emissividade');

  return image.addBands(emissividade)
              .set('year', image.date().get('year'))
              .set('month', image.date().get('month'));
}

// **************** //
//        LST       //
// **************** //

// Função para calcular LST
function calcularLST(image) {
  var lst = image.expression(
  '(BT / (1 + (10.8 * (BT / 14380)) * log(emiss))) - 273.15', {
  'BT': image.select('TERMAL'),  // Aqui usamos 'TERMAL' e não 'B10' ou 'B6'
  'emiss': image.select('emissividade')
  }).rename('LST');
    
  return image.addBands(lst)
              .set('year', image.date().get('year'))
              .set('month', image.date().get('month'));
}


