// Função para mascarar nuvens e sombras de nuvens usando a banda QA_PIXEL
function maskClouds(image) {
  var qa = image.select('QA_PIXEL'); // Seleciona a banda de qualidade

  // Máscara para nuvens (bits 3 e 4) e sombras de nuvens (bit 5)
  var cloudMask = qa.bitwiseAnd(1 << 3).eq(0) // Bit 3: Nuvens - realiza uma operação de deslocamento de bits, buscando o bit 3 (que representa a nuvem). A operação eq(0) verifica se o valor desse bit é 0, ou seja, o pixel não está coberto por nuvem.
             .and(qa.bitwiseAnd(1 << 4).eq(0)) // Bit 4: Nuvens de alta confiança
             .and(qa.bitwiseAnd(1 << 5).eq(0)); // Bit 5: Sombras de nuvens

  return image.updateMask(cloudMask); // Aplica a máscara
}

