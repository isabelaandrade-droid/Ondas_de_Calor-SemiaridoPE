import numpy as np # Necessário para inserir NaN

USO_SOLO_EXCLUIR = [22, 23, 24, 25, 26, 27, 30, 31, 33]

def remover_outliers_grade(df, variaveis):
    """
    Substitui por NaN (não exclui a linha):
    - LST < 8 ou > 48
    - Outliers (IQR) apenas se uso_solo for indesejado
    """
    # Não usamos df.copy() aqui se quisermos economizar RAM,
    # mas é seguro manter para não alterar o original sem querer.
    df = df.copy()

    # 1. Limpar LST fora do intervalo biológico (Substituir por NaN)
    if "lst" in df.columns:
        # A lógica é: Onde for menor que 8 OU maior que 48, vira NaN
        mask_lst_ruim = (df["lst"] < 8) | (df["lst"] > 48)
        df.loc[mask_lst_ruim, "lst"] = np.nan

    # 2. Limpar outliers condicionais ao uso do solo
    for v in variaveis:
        if v not in df.columns:
            continue

        # Calcula IQR
        q1 = df[v].quantile(0.25)
        q3 = df[v].quantile(0.75)
        iqr = q3 - q1

        lim_inf = q1 - 1.5 * iqr
        lim_sup = q3 + 1.5 * iqr

        # Máscara do valor extremo
        mask_outlier = (df[v] < lim_inf) | (df[v] > lim_sup)

        if "uso_solo" in df.columns:
            # Só remove se for outlier E estiver no uso de solo ruim
            mask_remover = mask_outlier & df["uso_solo"].isin(USO_SOLO_EXCLUIR)

            # AQUI ESTÁ A MÁGICA: Não deletamos a linha, anulamos o valor
            if mask_remover.any():
                df.loc[mask_remover, v] = np.nan

    return df

