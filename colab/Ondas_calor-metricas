import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns
from pathlib import Path
import gc
import numpy as np

# ==============================================================================
# 1. CONFIGURAÇÕES
# ==============================================================================
BASE_DIR = Path("/content/drive/MyDrive/..... /SAIDA_FINAL")

# Pastas de Origem
DIR_LST = BASE_DIR / "MAPAS_RESUMO"
DIR_TAR = BASE_DIR / "MAPAS_RESUMO_ERA5"
DIR_COMB = BASE_DIR / "METRICAS_ACOPLAMENTO_FINAL"

# Pasta para Salvar
OUT_MAPAS_IMG = BASE_DIR / "IMAGENS_MAPAS_FINAL"
OUT_MAPAS_IMG.mkdir(parents=True, exist_ok=True)

print(f" Preparando gerador de mapas (Estilo Visual Ajustado)...")

# ==============================================================================
# 2. FUNÇÃO DE CONSOLIDAÇÃO (Mantida a lógica, ajuste leve)
# ==============================================================================
def consolidar_dados_espaciais(diretorio, tipo_dado):
    print(f"\n Processando dados de: {tipo_dado}...")

    arquivos = list(diretorio.rglob("*.parquet"))

    if not arquivos:
        print(f"   Nenhum arquivo encontrado.")
        return None

    # Define colunas
    if tipo_dado == "ACOPLADO":
        cols = ['latitude', 'longitude', 'freq_eventos', 'dias_sob_onda', 'magnitude_lst_total']
        c_freq, c_dias, c_mag = 'freq_eventos', 'dias_sob_onda', 'magnitude_lst_total'
    else:
        cols = ['latitude', 'longitude', 'num_eventos', 'total_dias_onda', 'intensidade_acumulada']
        c_freq, c_dias, c_mag = 'num_eventos', 'total_dias_onda', 'intensidade_acumulada'

    dfs = []
    for f in arquivos:
        try:
            dfs.append(pd.read_parquet(f, columns=cols))
        except: continue

    if not dfs: return None

    df_bruto = pd.concat(dfs, ignore_index=True)

    # Agrupa por pixel (Lat/Lon)
    df_pixel = df_bruto.groupby(['latitude', 'longitude']).sum().reset_index()

    # Calcula Métricas
    df_pixel['Frequencia'] = df_pixel[c_freq]
    # Evita divisão por zero
    df_pixel['Duracao'] = df_pixel[c_dias] / df_pixel[c_freq].replace(0, 1)
    df_pixel['Magnitude'] = df_pixel[c_mag] / df_pixel[c_freq].replace(0, 1) # Magnitude média por evento

    # Filtra onde não teve evento
    df_final = df_pixel[df_pixel['Frequencia'] > 0].copy()

    return df_final[['latitude', 'longitude', 'Frequencia', 'Duracao', 'Magnitude']]

# ==============================================================================
# 3. FUNÇÃO DE PLOTAGEM (AJUSTADA: Cores e Títulos)
# ==============================================================================
def plotar_mapa_bonito(df, coluna, titulo_grafico, label_legenda, cmap, arquivo_saida):
    if df is None or df.empty: return

    plt.figure(figsize=(10, 8))

    # --- MELHORIA DE CONTRASTE ---
    # Calcula o percentil 98% para definir o "Maximo Visual".
    # Isso evita que um único pixel extremo deixe o mapa todo branco.
    vmax = df[coluna].quantile(0.98)

    # Scatter plot
    sc = plt.scatter(df['longitude'], df['latitude'],
                     c=df[coluna],
                     cmap=cmap,
                     s=1.5,           # Pontos levemente maiores para preencher
                     marker='s',      # Quadrado (square) preenche melhor que bola
                     alpha=1.0,
                     vmin=0,          # Garante que o branco comece no 0
                     vmax=vmax)       # Teto visual para contraste

    # Barra de Cores
    cbar = plt.colorbar(sc, fraction=0.03, pad=0.04)
    cbar.set_label(label_legenda, size=12)

    # Títulos e Eixos
    plt.title(titulo_grafico, fontsize=15, fontweight='bold', pad=15)
    plt.xlabel("Longitude")
    plt.ylabel("Latitude")
    plt.axis('equal') # Mantém a proporção do mapa correta

    # Remove bordas desnecessárias do gráfico (estilo "clean")
    sns.despine()

    # Salva
    plt.savefig(OUT_MAPAS_IMG / arquivo_saida, dpi=300, bbox_inches='tight')
    plt.close()
    print(f"   Mapa salvo: {arquivo_saida}")

# ==============================================================================
# 4. EXECUÇÃO
# ==============================================================================

# Configuração das tarefas
# Estrutura: (Pasta, Nome_Dado, Titulo_Base)
tarefas = [
    (DIR_LST,  "LST",      "Temperatura da Superfície (LST)"),
    (DIR_TAR,  "ERA5",     "Temperatura do Ar (ERA5)"),
    (DIR_COMB, "ACOPLADO", "Eventos Acoplados (LST+Ar)")
]

for diretorio, nome_dado, titulo_base in tarefas:

    # 1. Processar
    df_geo = consolidar_dados_espaciais(diretorio, nome_dado)

    if df_geo is not None:
        # 2. Gerar Mapas com as Cores Pedidas

        # --- FREQUÊNCIA (Branco -> Vermelho) ---
        plotar_mapa_bonito(
            df_geo,
            coluna='Frequencia',
            titulo_grafico=f"Frequência de Ondas de Calor - {titulo_base}",
            label_legenda="Número Total de Eventos",
            cmap="Reds",
            arquivo_saida=f"Mapa_{nome_dado}_Frequencia.png"
        )

        # --- DURAÇÃO (Branco -> Marrom/Laranja) ---
        # 'YlOrBr' é excelente para representar "seca" ou duração
        plotar_mapa_bonito(
            df_geo,
            coluna='Duracao',
            titulo_grafico=f"Duração Média dos Eventos - {titulo_base}",
            label_legenda="Duração Média (Dias)",
            cmap="YlOrBr",
            arquivo_saida=f"Mapa_{nome_dado}_Duracao.png"
        )

        # --- MAGNITUDE (Branco -> Roxo) ---
        plotar_mapa_bonito(
            df_geo,
            coluna='Magnitude',
            titulo_grafico=f"Magnitude Média (Severidade) - {titulo_base}",
            label_legenda="Magnitude (°C acumulados / dia)",
            cmap="Purples",
            arquivo_saida=f"Mapa_{nome_dado}_Magnitude.png"
        )

        # Salva CSV
        df_geo.to_csv(OUT_MAPAS_IMG / f"DADOS_GEO_{nome_dado}.csv", index=False)

        del df_geo
        gc.collect()

print("\n Mapas gerados com sucesso!")

