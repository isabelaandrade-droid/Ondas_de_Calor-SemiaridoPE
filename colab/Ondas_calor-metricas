DIR_TAR = BASE_DIR / "MAPAS_RESUMO_ERA5"
DIR_COMB = BASE_DIR / "METRICAS_ACOPLAMENTO_FINAL"

OUT_TABELA = BASE_DIR / "TABELA_FINAL"
OUT_TABELA.mkdir(exist_ok=True)

print(" Iniciando cálculo das estatísticas globais...")

# ==============================================================================
# 2. FUNÇÃO CALCULADORA
# ==============================================================================
def calcular_metricas(diretorio, tipo_dado):
    """
    Lê todos os parquets do diretório (e subdiretórios) e calcula médias ponderadas.
    """
    # --- CORREÇÃO AQUI: USAR rglob PARA ENTRAR NAS SUBPASTAS ---
    arquivos = list(diretorio.rglob("*.parquet"))

    if not arquivos:
        print(f" Nenhum arquivo encontrado em {diretorio.name}")
        return None

    print(f"    Lendo {len(arquivos)} arquivos de {tipo_dado}...", end=" ")

    # Define quais colunas buscar dependendo do tipo de dado
    if tipo_dado == "Acoplado (LST+Tar)":
        cols = ['freq_eventos', 'duracao_media', 'intensidade_lst_media', 'intensidade_ar_media', 'magnitude_lst_total', 'magnitude_ar_total']
        col_freq = 'freq_eventos'
    else: # LST ou ERA5
        cols = ['num_eventos', 'total_dias_onda', 'intensidade_media', 'intensidade_acumulada']
        col_freq = 'num_eventos'

    try:
        df = pd.concat([pd.read_parquet(f, columns=cols) for f in arquivos], ignore_index=True)
    except Exception as e:
        print(f"\n   Erro ao ler arquivos: {e}")
        return None

    # --- CÁLCULOS ---
    total_eventos = df[col_freq].sum()

    if total_eventos == 0:
        print(" (Total de eventos = 0)")
        return None

    stats = {
        "Tipo de Evento": tipo_dado,
        "Frequência Total (Eventos)": total_eventos,
    }

    # Lógica condicional para cálculo das médias
    if tipo_dado == "Acoplado (LST+Tar)":
        # Média ponderada pela frequência dos eventos
        stats["Duração Média (dias)"] = np.average(df['duracao_media'], weights=df[col_freq])

        # Intensidade
        int_lst = np.average(df['intensidade_lst_media'], weights=df[col_freq])
        int_ar = np.average(df['intensidade_ar_media'], weights=df[col_freq])
        stats["Intensidade Média (°C)"] = f"LST: {int_lst:.2f} | Ar: {int_ar:.2f}"

        # Magnitude
        mag_lst = df['magnitude_lst_total'].sum() / total_eventos
        mag_ar = df['magnitude_ar_total'].sum() / total_eventos
        stats["Magnitude Média"] = f"LST: {mag_lst:.2f} | Ar: {mag_ar:.2f}"

    else:
        # Para LST e ERA5 (Isolados)
        stats["Duração Média (dias)"] = df['total_dias_onda'].sum() / total_eventos

        # Intensidade Média (ponderada)
        mask = df['intensidade_media'] > 0
        if mask.any() and df.loc[mask, col_freq].sum() > 0:
            stats["Intensidade Média (°C)"] = np.average(df.loc[mask, 'intensidade_media'], weights=df.loc[mask, col_freq])
        else:
            stats["Intensidade Média (°C)"] = 0

        # Magnitude Média
        stats["Magnitude Média"] = df['intensidade_acumulada'].sum() / total_eventos

    print("Calculado.")
    return stats

# ==============================================================================
# 3. EXECUÇÃO E FORMATAÇÃO
# ==============================================================================
resumo_final = []

# Processa cada tipo
resumo_final.append(calcular_metricas(DIR_LST, "LST (Satélite)"))
