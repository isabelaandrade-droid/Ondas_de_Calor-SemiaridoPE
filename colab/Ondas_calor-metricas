    cols_presentes = [c for c in cols_order if c in df_tabela.columns]
    df_exibicao = df_tabela[cols_presentes].copy()

    print("\n" + "="*80)
    print("TABELA RESUMO DE ONDAS DE CALOR")
    print("="*80)

    # Formata para exibir bonito no terminal
    pd.options.display.float_format = '{:,.2f}'.format
    print(df_exibicao.to_string(index=False))

    # Salva CSV Limpo
    caminho_csv = OUT_TABELA / "Tabela_Resumo_Artigo.csv"
