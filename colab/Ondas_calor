# ==============================================================================
BASE_DIR = Path("/content/drive/MyDrive/GEE_Mestrado/PARQUET/SAIDA_FINAL")

# Diretórios dos dados
DIR_LST = BASE_DIR / "MAPAS_RESUMO"
DIR_TAR = BASE_DIR / "MAPAS_RESUMO_ERA5"
DIR_COMB = BASE_DIR / "METRICAS_ACOPLAMENTO_FINAL"

# Onde salvar o gráfico
