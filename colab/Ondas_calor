        ids_manchas, contagem_pixels = np.unique(matriz_rotulada, return_counts=True)

        # Filtro: Só conta manchas que não são o fundo (ID 0) e têm tamanho >= MIN_PIXELS
        manchas_reais = [c for i, c in zip(ids_manchas, contagem_pixels) if i != 0 and c >= MIN_PIXELS]

