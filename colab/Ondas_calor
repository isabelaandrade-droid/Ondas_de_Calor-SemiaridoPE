CORES = {
    "LST (Soil)": "#ff7f0e",       # Laranja
    "Tar (Air)": "#1f77b4",         # Azul
    "Coupled (LST+Tar)": "#d62728" # Vermelho
}

print("📊 Lendo dados e consolidando frequências anuais...")

# ==============================================================================
# 2. FUNÇÃO PARA LER E AGRUPAR POR ANO
# ==============================================================================
def obter_frequencia_anual(diretorio, nome_coluna_freq, rotulo_legenda):
    if not diretorio.exists():
        print(f"⚠ Pasta não encontrada: {diretorio}")
        return pd.DataFrame()

    # --- CORREÇÃO 1: USAR rglob PARA BUSCAR EM SUBPASTAS ---
    # Seus arquivos estão dentro de pastas de microrregiões (ex: MAPAS_RESUMO/Micro_X/arquivo.parquet)
    arquivos = list(diretorio.rglob("*.parquet"))

    if not arquivos:
        print(f"⚠ Nenhum arquivo encontrado em {diretorio.name} (Verifique se processou o passo anterior)")
        return pd.DataFrame()

    print(f"   📂 Processando {rotulo_legenda} ({len(arquivos)} arquivos encontrados)...")

    # Lê apenas as colunas 'ano' e a de 'frequencia'
    dfs = []
    for f in arquivos:
        try:
            # Tenta ler colunas. Se falhar, pula.
            df = pd.read_parquet(f, columns=["ano", nome_coluna_freq])
            dfs.append(df)
        except Exception:
            continue

    if not dfs:
        return pd.DataFrame()

    df_full = pd.concat(dfs, ignore_index=True)

    # Agrupa por ano e soma a frequência
    df_anual = df_full.groupby("ano")[nome_coluna_freq].sum().reset_index()

    # Renomeia para padronizar (Tudo com Maiúscula para evitar erro depois)
    df_anual.columns = ["Ano", "Frequencia"]
    df_anual["Tipo"] = rotulo_legenda

    return df_anual

# ==============================================================================
# 3. CARREGAR OS DADOS
# ==============================================================================

# LST (Usa a coluna 'num_eventos')
df_lst = obter_frequencia_anual(DIR_LST, "num_eventos", "LST (Soil)")

# Tar - ERA5 (Usa a coluna 'num_eventos')
df_tar = obter_frequencia_anual(DIR_TAR, "num_eventos", "Tar (Air)")

# Acoplado (Usa a coluna 'freq_eventos')
df_comb = obter_frequencia_anual(DIR_COMB, "freq_eventos", "Coupled (LST+Tar)")

# Junta tudo num dataframe só para o Seaborn
df_final = pd.concat([df_lst, df_tar, df_comb], ignore_index=True)

# ==============================================================================
# 4. PLOTAR O GRÁFICO
# ==============================================================================
if not df_final.empty:
    # --- CORREÇÃO 2: GARANTIR NOME DA COLUNA ---
    # Como renomeamos para "Ano" (Maiúsculo) na função, usamos "Ano" aqui
    df_final["Ano"] = df_final["Ano"].astype(int)
    df_final = df_final.sort_values("Ano")

    plt.figure(figsize=(12, 6))
    sns.set_style("whitegrid")

    # Plota as linhas com marcadores
    sns.lineplot(
        data=df_final,
        x="Ano",
        y="Frequencia",
        hue="Tipo",
        palette=CORES,
        style="Tipo",
        markers=True,
        dashes=False,
        linewidth=2.5,
        markersize=8
    )

    # Títulos e Eixos
    # plt.title("Frequência Anual de Ondas de Calor: Solo vs Ar vs Acopladas", fontsize=16, fontweight='bold', pad=15)
    plt.xlabel("Year", fontsize=12)
    plt.ylabel("Total Number of Detected Events", fontsize=12)

    # Ajuste do Eixo X para mostrar todos os anos inteiros
    anos_unicos = df_final["Ano"].unique()
    plt.xticks(anos_unicos, rotation=45)

    # Legenda
    plt.legend(title="Event Type", fontsize=11, title_fontsize=12)

    plt.tight_layout()

    # Salvar
    plt.savefig(ARQUIVO_GRAFICO, dpi=300)
    plt.show()

    print(f"\n✅ Gráfico salvo com sucesso em:\n{ARQUIVO_GRAFICO}")

    # Exibe tabela rápida no console
    print("\n--- Resumo dos Dados Plotados ---")
    pivoted = df_final.pivot(index="Ano", columns="Tipo", values="Frequencia").fillna(0)
    print(pivoted)

else:
    print("❌ Erro: Dataframe vazio. Isso significa que o script não encontrou nenhum arquivo .parquet nas subpastas.")
    print(f"   Verifique se a pasta {DIR_LST} realmente contém subpastas com arquivos.")

