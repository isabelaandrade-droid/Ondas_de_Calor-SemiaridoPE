print("=== REPROCESSANDO INMET (COM LAT/LON) ===")

arquivo_inmet_final = os.path.join(OUT, "INMET.parquet")

if os.path.exists(arquivo_inmet_final):
    os.remove(arquivo_inmet_final)
    print("🗑 Arquivo INMET.parquet antigo foi deletado.")

def padronizar_cabecalho(txt):
    """Limpa o nome das colunas"""
    if pd.isna(txt): return ""
    txt = str(txt).strip().lower()
    txt = unicodedata.normalize("NFKD", txt).encode("ascii", "ignore").decode("utf-8")
    return txt.replace(" ", "_").replace(".", "")

# ==============================================================================
# 2. LER E PROCESSAR CSVs
# ==============================================================================
arquivos_inmet = glob(os.path.join(PASTAS["INMET"], "*.csv"))
dfs_inmet = []

print(f" Lendo {len(arquivos_inmet)} arquivos CSV do INMET...")

for f in arquivos_inmet:
    try:
        df = pd.read_csv(f, sep=None, engine="python", encoding="latin1",
                         encoding_errors="ignore", decimal=",")

        # 1. Limpa cabeçalho
        df.columns = [padronizar_cabecalho(c) for c in df.columns]

        # 2. Renomear (INCLUINDO LAT/LON AGORA)
        renomear = {}
        for c in df.columns:
            if "temperatura" in c and "max" in c: renomear[c] = "tmax"
            elif "temperatura" in c and "min" in c: renomear[c] = "tmin"
            elif any(x in c for x in ["nome", "estacao", "municipio", "cidade"]): renomear[c] = "municipio"
            elif "data" in c: renomear[c] = "data"
            # ADICIONADO AQUI:
            elif "latitude" in c: renomear[c] = "latitude"
            elif "longitude" in c: renomear[c] = "longitude"
            elif "elevation" in c or "altitude" in c: renomear[c] = "altitude"

        df = df.rename(columns=renomear)

        # 3. Filtra colunas úteis (AGORA COM LAT/LON)
        cols_desejadas = ["municipio", "data", "tmax", "tmin", "latitude", "longitude", "altitude"]
        cols_existentes = [c for c in df.columns if c in cols_desejadas]

        df = df[cols_existentes]

        dfs_inmet.append(df)

    except Exception as e:
        print(f"⚠ Erro ao ler {os.path.basename(f)}: {e}")

if not dfs_inmet:
    raise ValueError("Nenhum CSV do INMET foi carregado!")

# Junta tudo
df_inmet = pd.concat(dfs_inmet, ignore_index=True)

# ==============================================================================
# 3. LIMPEZA DE DADOS
# ==============================================================================

# --- A. CORREÇÃO DE DUPLICIDADE (IGUAL ANTES) ---
df_inmet = df_inmet.loc[:, ~df_inmet.columns.duplicated()]

# --- B. LIMPAR MUNICÍPIO ---
df_inmet["municipio"] = df_inmet["municipio"].astype(str).str.lower().str.strip()
df_inmet["municipio"] = df_inmet["municipio"].apply(
    lambda x: unicodedata.normalize("NFKD", x).encode("ascii", "ignore").decode("utf-8") if isinstance(x, str) else x
)

# --- C. LIMPAR DATA ---
df_inmet["data"] = pd.to_datetime(df_inmet["data"], dayfirst=True, errors="coerce")

# --- D. LIMPAR NÚMEROS (AGORA INCLUI LAT/LON) ---
# O INMET costuma usar vírgula em latitude também (ex: -8,5)
cols_numericas = ["tmax", "tmin", "latitude", "longitude", "altitude"]

for col in cols_numericas:
    if col in df_inmet.columns:
        if df_inmet[col].dtype == "object":
             df_inmet[col] = df_inmet[col].astype(str).str.replace(",", ".")
        df_inmet[col] = pd.to_numeric(df_inmet[col], errors="coerce")

# Remove vazios essenciais
df_inmet = df_inmet.dropna(subset=["data", "municipio"])

# ==============================================================================
# 4. SALVAR E CONFERIR
# ==============================================================================
df_inmet.to_parquet(arquivo_inmet_final, index=False)

print(f"\n INMET REPROCESSADO (COM GEOMETRIA)!")
