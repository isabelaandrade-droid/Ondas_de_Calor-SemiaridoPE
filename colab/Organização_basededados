if grades:
    plotar_mapa_rapido(grades[0], "Amostra da GRADE")


import folium
from folium.plugins import FastMarkerCluster

def mapa_interativo(caminho_parquet):
    df = pd.read_parquet(caminho_parquet)

    # Pega lat/lon
    col_lat = next((c for c in df.columns if 'lat' in c), None)
    col_lon = next((c for c in df.columns if 'lon' in c), None)

    if not col_lat: return

    # Remove erros de lat/lon vazios antes de plotar
    df = df.dropna(subset=[col_lat, col_lon])

    # Cria o mapa centralizado na média dos pontos
    centro_lat = df[col_lat].mean()
    centro_lon = df[col_lon].mean()
    m = folium.Map(location=[centro_lat, centro_lon], zoom_start=6)

    # Se forem MUITOS pontos (> 5000), usamos Cluster para não travar o navegador
    # Se forem poucos, plotamos círculos individuais
    if len(df) > 5000:
        print("Muitos pontos detectados. Usando clusterização...")
        dados_lat_lon = list(zip(df[col_lat], df[col_lon]))
        FastMarkerCluster(dados_lat_lon).add_to(m)
    else:
        for _, row in df.iterrows():
            folium.CircleMarker(
                location=[row[col_lat], row[col_lon]],
                radius=3,
                color='red',
                fill=True
            ).add_to(m)

    return m
