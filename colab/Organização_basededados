import matplotlib.pyplot as plt
import seaborn as sns

def plotar_mapa_rapido(caminho_parquet, titulo):
    # Lê o arquivo
    df = pd.read_parquet(caminho_parquet)

    # Tenta adivinhar os nomes das colunas de lat/lon (caso variem)
    cols = df.columns
    col_lat = next((c for c in cols if 'lat' in c), None)
    col_lon = next((c for c in cols if 'lon' in c), None)

    if not col_lat or not col_lon:
        print(f"⚠ Não encontrei colunas de Latitude/Longitude em {titulo}")
        return

    # Plota
    plt.figure(figsize=(10, 10))

    # Scatter plot: Longitude no X, Latitude no Y
    # alpha=0.5 ajuda a ver densidade (pontos sobrepostos ficam mais escuros)
    plt.scatter(df[col_lon], df[col_lat], s=1, alpha=0.5, c='blue')

    plt.title(f"Distribuição Espacial: {titulo}")
    plt.xlabel("Longitude")
    plt.ylabel("Latitude")
    plt.grid(True, linestyle='--', alpha=0.3)

    # Garante que a proporção do mapa não fique distorcida (esticada)
    plt.gca().set_aspect('equal', adjustable='box')

    plt.show()
    print(f"Total de pontos plotados: {len(df)}")

# --- TESTE COM UM ARQUIVO DE CADA TIPO ---

# 1. Testar INMET
arquivo_inmet = os.path.join(OUT, "INMET.parquet")
plotar_mapa_rapido(arquivo_inmet, "Estações INMET")

# 2. Testar um arquivo da GRADE (pega o primeiro que encontrar)
