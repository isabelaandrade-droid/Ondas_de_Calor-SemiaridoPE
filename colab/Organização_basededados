def padronizar_texto(txt):
    """Remove acentos, põe em minúsculo e remove espaços extras."""
    if pd.isna(txt):
        return ""
    txt = str(txt).strip().lower()
    txt = unicodedata.normalize("NFKD", txt).encode("ascii", "ignore").decode("utf-8")
    txt = " ".join(txt.split())
    return txt

def concatenar_csv_para_parquet(pasta_base, microrregiao, tipo):
    arquivo_saida = os.path.join(OUT, f"{tipo}_{microrregiao}.parquet")

    if os.path.exists(arquivo_saida):
        print(f" {arquivo_saida} já existe — pulando.")
        return None # Não precisa ler se não for usar agora

    caminho_mr = os.path.join(pasta_base, microrregiao)
    arquivos_csv = glob(os.path.join(caminho_mr,"**/*.csv"), recursive=True)

    if not arquivos_csv:
        print(f" Nenhum CSV encontrado em {caminho_mr}")
        return None

    dfs = []
    for f in arquivos_csv:
        try:
            # engine='python' é mais lento, mas lida melhor com separadores ruins
            df = pd.read_csv(f, sep=None, engine="python", encoding="latin1", encoding_errors="ignore")
            dfs.append(df)
            print(f"  ✔ {os.path.basename(f)} ({df.shape[0]} linhas)")
        except Exception as e:
            print(f" Erro ao ler {f}: {e}")

    if not dfs:
        return None

    df_final = pd.concat(dfs, ignore_index=True)

    # Salva em Parquet
    df_final.to_parquet(arquivo_saida, index=False)
    print(f" Salvo: {arquivo_saida} | Linhas: {df_final.shape[0]}")

    # Limpa memória
    del dfs, df_final
    gc.collect()

# ==============================================================================
# 3. PROCESSAMENTO: GRADE E ERA5 (CONCATENAÇÃO)
# ==============================================================================
print("\n=== PROCESSANDO GRADE E ERA5 ===")
for tipo in ["GRADE", "ERA5"]:
    if os.path.exists(PASTAS[tipo]):
        micros = sorted(os.listdir(PASTAS[tipo]))
        for mr in micros:
            concatenar_csv_para_parquet(PASTAS[tipo], mr, tipo)

# ==============================================================================
# 4. PROCESSAMENTO: INMET (CONSOLIDAÇÃO E LIMPEZA)
# ==============================================================================
print("\n=== PROCESSANDO INMET ===")

arquivo_inmet_final = os.path.join(OUT, "INMET.parquet")

# Só processa se ainda não existir (ou se quiser refazer, apague o arquivo antes)
arquivos_inmet = glob(os.path.join(PASTAS["INMET"], "*.csv"))
dfs_inmet = []

for f in arquivos_inmet:
    try:
        # decimal="," é CRUCIAL para o INMET
        df = pd.read_csv(f, sep=None, engine="python", encoding="latin1",
                         encoding_errors="ignore", decimal=",")
        dfs_inmet.append(df)
    except Exception as e:
        print(f" Erro ao ler {f}: {e}")

if dfs_inmet:
    df_inmet = pd.concat(dfs_inmet, ignore_index=True)

    # --- LIMPEZA DE TIPOS INMET ---
    for col in df_inmet.columns:
        # Se for objeto (texto), tenta virar número primeiro
        if df_inmet[col].dtype == "object":
            # errors='coerce' transforma "falha" em NaN (vazio), garantindo que a coluna vire numérica
            df_inmet[col] = pd.to_numeric(df_inmet[col], errors='coerce')

        # Se após tentar virar número ainda sobrar texto/vazio misturado:
        if df_inmet[col].dtype == "object":
             df_inmet[col] = df_inmet[col].astype(str).replace('nan', None)

    # --- PADRONIZAÇÃO DE TEXTO E COLUNAS ---
    df_inmet.columns = [padronizar_texto(c) for c in df_inmet.columns]

    # Aplica padronização apenas nas colunas que sobraram como TEXTO (para não estragar números)
    colunas_texto = df_inmet.select_dtypes(include=['object']).columns
    df_inmet[colunas_texto] = df_inmet[colunas_texto].applymap(padronizar_texto)

    # Renomear
    renomear = {}
    for c in df_inmet.columns:
        if "temperatura" in c and "max" in c: renomear[c] = "tmax"
        elif "temperatura" in c and "min" in c: renomear[c] = "tmin"
        elif "nome" in c or "municipio" in c: renomear[c] = "municipio"
        elif "data" in c: renomear[c] = "data"

    df_inmet = df_inmet.rename(columns=renomear)

    # Data
    if "data" in df_inmet.columns:
        df_inmet["data"] = pd.to_datetime(df_inmet["data"], dayfirst=True, errors="coerce")

    # Salva
    df_inmet.to_parquet(arquivo_inmet_final, index=False)
    print(f" INMET Consolidado salvo: {df_inmet.shape[0]} linhas")

    del df_inmet, dfs_inmet
    gc.collect()

# ==============================================================================
# 5. PADRONIZAÇÃO FINAL: ERA5 E GRADE
# ==============================================================================
print("\n=== PADRONIZANDO ERA5 E GRADE JÁ SALVOS ===")

# Pegar todos os parquets gerados (exceto INMET)
arquivos_para_padronizar = glob(os.path.join(OUT, "ERA5_*.parquet")) + glob(os.path.join(OUT, "GRADE_*.parquet"))

for arquivo in arquivos_para_padronizar:
    try:
        df = pd.read_parquet(arquivo)

        # Verifica se já foi padronizado (para ganhar tempo)
        if "__padronizado__" in df.columns:
            print(f" {os.path.basename(arquivo)} já padronizado.")
            continue

        # Padroniza Colunas
        df.columns = [padronizar_texto(c) for c in df.columns]

        # Padroniza Conteúdo (Apenas Strings)
        cols_str = df.select_dtypes(include=['object']).columns
        if len(cols_str) > 0:
            df[cols_str] = df[cols_str].applymap(padronizar_texto)

        # Renomeia
        renomear = {}
        for c in df.columns:
            if ("temperatura" in c and "max" in c) or c=="tmax_c": renomear[c] = "tmax"
            elif ("temperatura" in c and "min" in c) or c=="tmin_c": renomear[c] = "tmin"
            elif any(x in c for x in ["municipio", "estacao", "cidade"]): renomear[c] = "municipio"
            elif "ano" in c: renomear[c] = "ano"
            elif "mes" in c: renomear[c] = "mes"
            elif "dia" in c: renomear[c] = "dia"

        df = df.rename(columns=renomear)

        # Data
        if all(col in df.columns for col in ["dia", "mes", "ano"]):
            df["data"] = pd.to_datetime(
                df["ano"].astype(str) + "-" +
                df["mes"].astype(str).str.zfill(2) + "-" +
                df["dia"].astype(str).str.zfill(2),
                errors="coerce"
            )

        # Marca como pronto e salva
        df["__padronizado__"] = True
        df.to_parquet(arquivo, index=False)
        print(f" Atualizado: {os.path.basename(arquivo)}")

        del df
        gc.collect()

    except Exception as e:
        print(f" Erro ao padronizar {os.path.basename(arquivo)}: {e}")

print("\n Processamento Concluído! Todos os dados estão na pasta PARQUET.")

import pandas as pd
